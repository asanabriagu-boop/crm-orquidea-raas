# ── CRM Conversacional · Variables de Entorno ──

# Puerto del servidor (default: 3030)
CRM_PORT=3030

# Host (default: 0.0.0.0)
CRM_HOST=0.0.0.0

# URL base (para links de checkout, webhooks)
BASE_URL=http://localhost:3030

# ── Stripe (opcional en desarrollo, usa mock si no se configura) ──
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_STARTER=price_starter_id
STRIPE_PRICE_PROFESSIONAL=price_pro_id
STRIPE_PRICE_ENTERPRISE=price_enterprise_id

# ── Admin Dashboard ──
ADMIN_JWT_SECRET=changeme-in-production
ADMIN_PASSWORD=admin123

# ── CORS (default: todos los orígenes) ──
CORS_ORIGIN=*

# ── WhatsApp (opcional, se pasa como argumento también) ──
WHATSAPP_PHONE=

# ── OpenAI (para transcripción de audio) ──
OPENAI_API_KEY=

# ── LangSmith Tracing (opcional, ver trazas en langsmith.langchain.com) ──
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=crm-conversacional
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=lsv2_...
